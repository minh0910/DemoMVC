@{
    ViewData["Title"] = "View → Controller";
}

<div class="lesson">
    <a asp-action="Index">← Mục 5</a>
    <h1>Ví dụ: View gửi dữ liệu về Controller</h1>
    <p>Thuộc tính <code>name</code> của thẻ input phải <strong>trùng tên tham số</strong> của action (không phân biệt hoa thường) thì model binding mới gán được.</p>

    <h2>Cách 1: Form GET → query string</h2>
    <div class="row g-3">
        <div class="col-lg-6">
<pre class="code"><span class="cm">&lt;!-- View --&gt;</span>
&lt;form asp-action="ViewSangController" method="get"&gt;
    &lt;input name="tuKhoa" /&gt;
    &lt;button type="submit"&gt;Tìm&lt;/button&gt;
&lt;/form&gt;
<span class="cm">&lt;!-- URL gửi đi: /DuLieu/ViewSangController?tuKhoa=an --&gt;</span>

<span class="cm">// Controller</span>
[HttpGet]
public IActionResult ViewSangController(string? tuKhoa)
{
    ViewBag.KetQuaTim = _dsSinhVien
        .Where(s =&gt; s.HoTen.Contains(tuKhoa)) ...;
    return View();
}</pre>
        </div>
        <div class="col-lg-6">
            <div class="demo-box">
                <form asp-action="ViewSangController" method="get" class="d-flex gap-2">
                    <input name="tuKhoa" class="form-control" placeholder="Nhập tên sinh viên, ví dụ: an" value="@ViewBag.TuKhoa" />
                    <button type="submit" class="btn btn-primary text-nowrap">Tìm (GET)</button>
                </form>
                @if (ViewBag.KetQuaTim != null)
                {
                    <p class="mt-3 mb-1">Controller nhận <code>tuKhoa = "@ViewBag.TuKhoa"</code>, tìm được @ViewBag.KetQuaTim.Count kết quả:</p>
                    <ul class="mb-0">
                        @foreach (var ten in ViewBag.KetQuaTim)
                        {
                            <li>@ten</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <h2>Cách 2: Form POST → tham số action / IFormCollection</h2>
    <div class="row g-3">
        <div class="col-lg-6">
<pre class="code"><span class="cm">&lt;!-- View --&gt;</span>
&lt;form asp-action="ViewSangController" method="post"&gt;
    &lt;input name="hoTen" /&gt;
    &lt;input name="namSinh" type="number" /&gt;
    &lt;select name="gioiTinh"&gt;...&lt;/select&gt;
    &lt;button type="submit"&gt;Gửi&lt;/button&gt;
&lt;/form&gt;

<span class="cm">// Controller</span>
[HttpPost]
public IActionResult ViewSangController(
    string hoTen, int namSinh, IFormCollection form)
{
    ViewBag.HoTen = hoTen;                  <span class="cm">// qua tham số</span>
    ViewBag.Tuoi = DateTime.Now.Year - namSinh;
    ViewBag.GioiTinh = form["gioiTinh"];    <span class="cm">// qua IFormCollection</span>
    return View();
}</pre>
        </div>
        <div class="col-lg-6">
            <div class="demo-box">
                <form asp-action="ViewSangController" method="post">
                    <div class="mb-2">
                        <label class="form-label">Họ tên</label>
                        <input name="hoTen" class="form-control" required value="@ViewBag.HoTen" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Năm sinh</label>
                        <input name="namSinh" type="number" class="form-control" required min="1900" max="@DateTime.Now.Year" value="@ViewBag.NamSinh" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Giới tính</label>
                        <select name="gioiTinh" class="form-select">
                            <option>Nam</option>
                            <option>Nữ</option>
                            <option>Khác</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-success">Gửi (POST)</button>
                </form>
                @if (ViewBag.HoTen != null)
                {
                    <div class="alert alert-success mt-3 mb-0">
                        Controller đã nhận: <strong>@ViewBag.HoTen</strong>, giới tính <strong>@ViewBag.GioiTinh</strong>,
                        sinh năm @ViewBag.NamSinh → năm nay <strong>@ViewBag.Tuoi tuổi</strong>.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
