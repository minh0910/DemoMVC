@model IEnumerable<DemoMVC.Models.Faculty>

@{ ViewData["Title"] = "Danh sách khoa"; }

<h1>Danh sách khoa</h1>
<p class="text-muted">Các khoa của Trường Đại học Mỏ - Địa chất.</p>
<partial name="_ThongBao" />

<p>
    <button type="button" class="btn btn-primary" data-ajax-modal="@Url.Action("Create")">Thêm khoa</button>
    <a class="btn btn-outline-secondary" asp-controller="Major" asp-action="Index">Ngành học</a>
    <a class="btn btn-outline-secondary" asp-controller="Student" asp-action="Index">Sinh viên</a>
</p>

<div class="table-responsive">
<table class="table table-striped table-hover align-middle">
    <thead class="table-light"><tr><th>@Html.DisplayNameFor(m => m.FacultyCode)</th><th>@Html.DisplayNameFor(m => m.Name)</th><th>Các ngành</th><th>Thao tác</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td><code>@item.FacultyCode</code></td><td>@item.Name</td>
            <td>@foreach (var major in item.Majors.OrderBy(m => m.MajorCode)) { <span class="badge text-bg-light border me-1">@major.MajorCode - @major.Name</span> }</td>
            <td class="text-nowrap">
                <button type="button" class="btn btn-sm btn-outline-info" data-ajax-modal="@Url.Action("Details", new { id = item.FacultyCode })">Xem</button>
                <button type="button" class="btn btn-sm btn-outline-primary" data-ajax-modal="@Url.Action("Edit", new { id = item.FacultyCode })">Sửa</button>
                <button type="button" class="btn btn-sm btn-outline-danger" data-ajax-modal="@Url.Action("Delete", new { id = item.FacultyCode })">Xóa</button>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
