@model IEnumerable<DemoMVC.Models.Faculty>

@{
    ViewData["Title"] = "Danh sách khoa";
}

<h1>Danh sách khoa</h1>
<p class="text-muted">Các khoa của Trường Đại học Mỏ - Địa chất. Bảng Ngành và bảng Sinh viên liên kết tới bảng này qua <strong>mã khoa</strong>.</p>

<partial name="_ThongBao" />

<p>
    <a class="btn btn-primary" asp-action="Create">Thêm khoa</a>
    <a class="btn btn-outline-secondary" asp-controller="Major" asp-action="Index">Ngành học</a>
    <a class="btn btn-outline-secondary" asp-controller="Student" asp-action="Index">Sinh viên</a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>@Html.DisplayNameFor(m => m.FacultyCode)</th>
                <th>@Html.DisplayNameFor(m => m.Name)</th>
                <th>Các ngành</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><code>@item.FacultyCode</code></td>
                    <td>@item.Name</td>
                    <td>
                        @foreach (var major in item.Majors.OrderBy(m => m.MajorCode))
                        {
                            <span class="badge text-bg-light border me-1">@major.MajorCode - @major.Name</span>
                        }
                    </td>
                    <td class="text-nowrap">
                        <a asp-action="Details" asp-route-id="@item.FacultyCode">Xem</a> |
                        <a asp-action="Edit" asp-route-id="@item.FacultyCode">Sửa</a> |
                        <a asp-action="Delete" asp-route-id="@item.FacultyCode">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
