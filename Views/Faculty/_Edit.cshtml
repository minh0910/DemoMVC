@model DemoMVC.Models.Faculty
<form asp-action="Edit" asp-route-id="@Model.FacultyCode" method="post" data-modal-title="Sửa khoa">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="FacultyCode" class="form-label"></label><input asp-for="FacultyCode" class="form-control" readonly /><div class="form-text">Mã khoa không thể thay đổi.</div></div>
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="text-end"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button> <button type="submit" class="btn btn-primary">Lưu thay đổi</button></div>
</form>
