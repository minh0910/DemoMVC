@model DemoMVC.Models.Faculty

@{
    ViewData["Title"] = "Sửa khoa";
}

<h1>Sửa khoa</h1>

<hr />

<form asp-action="Edit" asp-route-id="@Model.FacultyCode" method="post" class="col-md-6">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="FacultyCode" class="form-label"></label>
        <input asp-for="FacultyCode" class="form-control" readonly disabled />
        <div class="form-text">Mã khoa là khoá chính, ngành và sinh viên đang tham chiếu tới nên không sửa được.</div>
    </div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
