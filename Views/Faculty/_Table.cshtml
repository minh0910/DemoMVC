@model DemoMVC.Helpers.PaginatedList<DemoMVC.Models.Faculty>
@if (!Model.Any())
{
    <div class="alert alert-secondary">@(string.IsNullOrEmpty(Model.Keyword) ? "Chưa có khoa nào." : $"Không tìm thấy kết quả nào cho \"{Model.Keyword}\".")</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Mã khoa</th>
                    <th>Tên khoa</th>
                    <th>Các ngành</th>
                    <th class="text-end">Số SV</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><code>@item.FacultyCode</code></td>
                        <td>@item.Name</td>
                        <td>
                            @foreach (var major in item.Majors.OrderBy(m => m.MajorCode))
                            {
                                <span class="badge text-bg-light border me-1">@major.MajorCode - @major.Name</span>
                            }
                        </td>
                        <td class="text-end">@item.Students.Count</td>
                        <td class="text-nowrap">
                            <button class="btn btn-sm btn-outline-info" data-modal="@Url.Action("Details", new { id = item.FacultyCode })">Chi tiết</button>
                            <button class="btn btn-sm btn-outline-warning" data-modal="@Url.Action("Form", new { id = item.FacultyCode })">Sửa</button>
                            <button class="btn btn-sm btn-outline-danger" data-delete="@Url.Action("Delete", new { id = item.FacultyCode })" data-name="@item.Name">Xoá</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
<partial name="_Pager" model="Model" />
