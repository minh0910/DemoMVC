@model DemoMVC.Models.Faculty

@{
    ViewData["Title"] = "Xóa khoa";
    var soNganh = (int)ViewBag.MajorCount;
    var soSinhVien = (int)ViewBag.StudentCount;
    var duocXoa = soNganh == 0 && soSinhVien == 0;
}

<h1>Xóa khoa</h1>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.FacultyCode)</dt>
    <dd class="col-sm-9"><code>@Model.FacultyCode</code></dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Name)</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Số ngành</dt>
    <dd class="col-sm-9">@soNganh</dd>

    <dt class="col-sm-3">Số sinh viên</dt>
    <dd class="col-sm-9">@soSinhVien</dd>
</dl>

@if (duocXoa)
{
    <div class="alert alert-warning">Bạn có chắc muốn xóa khoa này?</div>
}
else
{
    <div class="alert alert-danger">
        Không xóa được: vẫn còn ngành hoặc sinh viên tham chiếu tới khoa này qua khoá ngoại.
        Hãy xóa hoặc chuyển các ngành, sinh viên đó trước.
    </div>
}

<form asp-action="Delete" asp-route-id="@Model.FacultyCode" method="post">
    <button type="submit" class="btn btn-danger" disabled="@(!duocXoa)">Xóa</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>
