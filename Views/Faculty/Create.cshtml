@model DemoMVC.Models.Faculty

@{
    ViewData["Title"] = "Thêm khoa";
}

<h1>Thêm khoa</h1>

<hr />

<form asp-action="Create" method="post" class="col-md-6">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="FacultyCode" class="form-label"></label>
        <input asp-for="FacultyCode" class="form-control" placeholder="Ví dụ: CNTT" />
        <div class="form-text">Chữ cái không dấu và chữ số, tự chuyển thành chữ in hoa. Không sửa được sau khi tạo.</div>
        <span asp-validation-for="FacultyCode" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="Ví dụ: Khoa Công nghệ thông tin" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
