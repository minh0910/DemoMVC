@model DemoMVC.Models.Faculty

@{
    ViewData["Title"] = Model.Name;
}

<h1>@Model.Name</h1>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.FacultyCode)</dt>
    <dd class="col-sm-9"><code>@Model.FacultyCode</code></dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Name)</dt>
    <dd class="col-sm-9">@Model.Name</dd>
</dl>

<h2 class="h5 mt-4">Các ngành thuộc khoa (@Model.Majors.Count)</h2>
@if (Model.Majors.Any())
{
    <ul>
        @foreach (var major in Model.Majors.OrderBy(m => m.MajorCode))
        {
            <li><code>@major.MajorCode</code> - @major.Name</li>
        }
    </ul>
}
else
{
    <p class="text-muted">Khoa chưa có ngành đào tạo.</p>
}

<h2 class="h5 mt-4">Sinh viên thuộc khoa (@Model.Students.Count)</h2>
@if (Model.Students.Any())
{
    <div class="table-responsive">
        <table class="table table-sm table-striped align-middle">
            <thead class="table-light">
                <tr><th>Mã sinh viên</th><th>Họ tên</th><th>Ngành</th><th>Năm nhập học</th></tr>
            </thead>
            <tbody>
                @foreach (var sv in Model.Students.OrderBy(s => s.StudentCode))
                {
                    <tr>
                        <td><a asp-controller="Student" asp-action="Details" asp-route-id="@sv.StudentCode">@sv.StudentCode</a></td>
                        <td>@sv.FullName</td>
                        <td>@sv.Major?.Name</td>
                        <td>@sv.EnrollmentYear</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p class="text-muted">Khoa chưa có sinh viên.</p>
}

<div class="mt-3">
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.FacultyCode">Sửa</a>
    <a class="btn btn-secondary" asp-action="Index">Quay lại</a>
</div>
