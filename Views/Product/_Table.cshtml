@model DemoMVC.Helpers.PaginatedList<DemoMVC.Models.Product>
@if (!Model.Any())
{
    <div class="alert alert-secondary">@(string.IsNullOrEmpty(Model.Keyword) ? "Chưa có sản phẩm nào." : $"Không tìm thấy kết quả nào cho \"{Model.Keyword}\".")</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Tên sản phẩm</th>
                    <th class="text-end">Giá</th>
                    <th>Ngày tạo</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td class="text-end">@item.Price.ToString("N0") đ</td>
                        <td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-nowrap">
                            <button class="btn btn-sm btn-outline-info" data-modal="@Url.Action("Details", new { id = item.Id })">Chi tiết</button>
                            <button class="btn btn-sm btn-outline-warning" data-modal="@Url.Action("Form", new { id = item.Id })">Sửa</button>
                            <button class="btn btn-sm btn-outline-danger" data-delete="@Url.Action("Delete", new { id = item.Id })" data-name="sản phẩm @item.Name">Xoá</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
<partial name="_Pager" model="Model" />
