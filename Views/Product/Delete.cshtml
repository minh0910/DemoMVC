@model DemoMVC.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<h1>Xóa sản phẩm</h1>

<h4 class="text-danger">Bạn có chắc muốn xóa sản phẩm này?</h4>

<div>
    <hr />

    <dl class="row">

        <dt class="col-sm-3">
            ID
        </dt>
        <dd class="col-sm-9">
            @Model.Id
        </dd>

        <dt class="col-sm-3">
            Tên sản phẩm
        </dt>
        <dd class="col-sm-9">
            @Model.Name
        </dd>

        <dt class="col-sm-3">
            Giá
        </dt>
        <dd class="col-sm-9">
            @Model.Price.ToString("N0") VNĐ
        </dd>

        <dt class="col-sm-3">
            Ngày tạo
        </dt>
        <dd class="col-sm-9">
            @Model.CreatedAt.ToLocalTime()
        </dd>

    </dl>
</div>

<form asp-controller="Product"
      asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit"
            class="btn btn-danger">
        Xóa
    </button>

    <a asp-controller="Product"
       asp-action="Index"
       class="btn btn-secondary">
        Quay lại
    </a>

</form>
