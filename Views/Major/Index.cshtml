@model IEnumerable<DemoMVC.Models.Major>

@{ ViewData["Title"] = "Danh sách ngành học"; }

<h1>Danh sách ngành học</h1>
<p class="text-muted">Mỗi ngành thuộc một khoa.</p>
<partial name="_ThongBao" />

<p>
    <button type="button" class="btn btn-primary" data-ajax-modal="@Url.Action("Create")">Thêm ngành</button>
    <a class="btn btn-outline-secondary" asp-controller="Faculty" asp-action="Index">Khoa</a>
    <a class="btn btn-outline-secondary" asp-controller="Student" asp-action="Index">Sinh viên</a>
</p>

<div class="table-responsive">
<table class="table table-striped table-hover align-middle">
    <thead class="table-light"><tr><th>@Html.DisplayNameFor(m => m.MajorCode)</th><th>@Html.DisplayNameFor(m => m.Name)</th><th>@Html.DisplayNameFor(m => m.FacultyCode)</th><th>Thao tác</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td><code>@item.MajorCode</code></td><td>@item.Name</td><td>@item.Faculty?.Name</td>
            <td class="text-nowrap">
                <button type="button" class="btn btn-sm btn-outline-primary" data-ajax-modal="@Url.Action("Edit", new { id = item.MajorCode })">Sửa</button>
                <button type="button" class="btn btn-sm btn-outline-danger" data-ajax-modal="@Url.Action("Delete", new { id = item.MajorCode })">Xóa</button>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
