@model DemoMVC.Models.Major
<form asp-action="Edit" asp-route-id="@Model.MajorCode" method="post" data-modal-title="Sửa ngành">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="MajorCode" class="form-label"></label><input asp-for="MajorCode" class="form-control" readonly /><div class="form-text">Mã ngành không thể thay đổi.</div></div>
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="FacultyCode" class="form-label"></label><select asp-for="FacultyCode" asp-items="ViewBag.FacultyList" class="form-select"><option value="">-- Chọn khoa --</option></select><div class="form-text">Chỉ đổi được khoa khi ngành chưa có sinh viên.</div><span asp-validation-for="FacultyCode" class="text-danger"></span></div>
    <div class="text-end"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button> <button type="submit" class="btn btn-primary">Lưu thay đổi</button></div>
</form>
