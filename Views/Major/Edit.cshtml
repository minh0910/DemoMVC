@model DemoMVC.Models.Major

@{
    ViewData["Title"] = "Sửa ngành";
}

<h1>Sửa ngành</h1>

<hr />

<form asp-action="Edit" asp-route-id="@Model.MajorCode" method="post" class="col-md-6">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="MajorCode" class="form-label"></label>
        <input asp-for="MajorCode" class="form-control" readonly disabled />
        <div class="form-text">Mã ngành nằm trong mã sinh viên nên không sửa được.</div>
    </div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FacultyCode" class="form-label"></label>
        <select asp-for="FacultyCode" asp-items="ViewBag.FacultyList" class="form-select">
            <option value="">-- Chọn khoa --</option>
        </select>
        <div class="form-text">Chỉ đổi được khoa khi ngành chưa có sinh viên.</div>
        <span asp-validation-for="FacultyCode" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
