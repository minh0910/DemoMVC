@model IEnumerable<DemoMVC.Models.Major>
@if (!Model.Any())
{
    <div class="alert alert-secondary">Chưa có ngành nào.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Mã ngành</th>
                    <th>Tên ngành</th>
                    <th>Khoa</th>
                    <th class="text-end">Số SV</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><code>@item.MajorCode</code></td>
                        <td>@item.Name</td>
                        <td>@item.Faculty?.Name</td>
                        <td class="text-end">@item.Students.Count</td>
                        <td class="text-nowrap">
                            <button class="btn btn-sm btn-outline-warning" data-modal="@Url.Action("Form", new { id = item.MajorCode })">Sửa</button>
                            <button class="btn btn-sm btn-outline-danger" data-delete="@Url.Action("Delete", new { id = item.MajorCode })" data-name="ngành @item.Name">Xoá</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
