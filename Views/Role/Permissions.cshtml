@model IEnumerable<DemoMVC.Models.Permission>
@{
    ViewData["Title"] = "Phân quyền theo Controller/Action";
    var role = (Microsoft.AspNetCore.Identity.IdentityRole)ViewBag.Role;
    var selectedIds = (HashSet<int>)ViewBag.SelectedIds;
    var groups = Model.GroupBy(permission => permission.Controller).OrderBy(group => group.Key);
}

<h2 class="mb-2">Phân quyền cho Role: @role.Name</h2>
<p class="text-muted">Chọn các action mà Role này được phép thực hiện. Thay đổi có hiệu lực ngay.</p>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form asp-controller="Role" asp-action="UpdatePermissions" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@role.Id" />

    @foreach (var group in groups)
    {
        <section class="card mb-3">
            <div class="card-header fw-bold">@group.Key</div>
            <div class="card-body d-flex flex-wrap gap-3">
                @foreach (var permission in group)
                {
                    <label class="form-check">
                        <input class="form-check-input" type="checkbox" name="permissionIds" value="@permission.Id"
                               checked="@(selectedIds.Contains(permission.Id))" />
                        <span class="form-check-label">@permission.Action</span>
                        <small class="text-muted d-block">@permission.DisplayName</small>
                    </label>
                }
            </div>
        </section>
    }

    <button type="submit" class="btn btn-primary">Lưu phân quyền</button>
    <a asp-controller="Role" asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>
