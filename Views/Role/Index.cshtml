@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>
@{
    ViewData["Title"] = "Quản lý Role";
}

<h2 class="mb-3">Quản lý Role</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-controller="Role" asp-action="Create" method="post" class="row g-2 mb-4">
    @Html.AntiForgeryToken()
    <div class="col-sm-6 col-md-4">
        <input name="name" class="form-control" maxlength="100" placeholder="Tên Role mới" required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Thêm Role</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Tên Role</th>
                <th style="width: 420px" class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.Name</td>
                <td class="text-end">
                    @if (role.Name != "Admin")
                    {
                        <form asp-controller="Role" asp-action="Update" method="post" class="d-inline-flex gap-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@role.Id" />
                            <input name="name" value="@role.Name" maxlength="100" class="form-control form-control-sm" required />
                            <button type="submit" class="btn btn-sm btn-warning">Sửa</button>
                        </form>
                        <form asp-controller="Role" asp-action="Delete" method="post" class="d-inline"
                              onsubmit="return confirm('Bạn có chắc muốn xoá Role này?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@role.Id" />
                            <button type="submit" class="btn btn-sm btn-danger">Xoá</button>
                        </form>
                    }
                    <a asp-controller="Role" asp-action="Permissions" asp-route-id="@role.Id"
                       class="btn btn-sm btn-info ms-1">Phân quyền</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
