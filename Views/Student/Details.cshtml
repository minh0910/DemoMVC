@model DemoMVC.Models.Student

@{
    ViewData["Title"] = "Thông tin sinh viên";
    var ma = Model.StudentCode;
    var duMa = ma.Length == 10;
}

<h1>Thông tin sinh viên</h1>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.StudentCode)</dt>
    <dd class="col-sm-9"><code class="fs-5">@Model.StudentCode</code></dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.FullName)</dt>
    <dd class="col-sm-9">@Model.FullName</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.DateOfBirth)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.DateOfBirth)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Email)</dt>
    <dd class="col-sm-9">@(Model.Email ?? "—")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.FacultyCode)</dt>
    <dd class="col-sm-9">
        <a asp-controller="Faculty" asp-action="Details" asp-route-id="@Model.FacultyCode">@Model.Faculty?.Name</a>
    </dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.MajorCode)</dt>
    <dd class="col-sm-9">@Model.Major?.Name</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.EnrollmentYear)</dt>
    <dd class="col-sm-9">@Model.EnrollmentYear</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.TrainingSystemCode)</dt>
    <dd class="col-sm-9">@TrainingSystems.GetName(Model.TrainingSystemCode)</dd>
</dl>

@if (duMa)
{
    <h2 class="h5 mt-4">Phân tích mã sinh viên</h2>
    <div class="table-responsive">
        <table class="table table-bordered text-center align-middle w-auto">
            <thead class="table-light">
                <tr><th>Năm nhập học</th><th>Hệ đào tạo</th><th>Ngành</th><th>Số thứ tự</th></tr>
            </thead>
            <tbody>
                <tr class="fs-5">
                    <td><code>@ma.Substring(0, 2)</code></td>
                    <td><code>@ma.Substring(2, 2)</code></td>
                    <td><code>@ma.Substring(4, 2)</code></td>
                    <td><code>@ma.Substring(6, 4)</code></td>
                </tr>
                <tr class="small text-muted">
                    <td>@Model.EnrollmentYear</td>
                    <td>@TrainingSystems.GetName(Model.TrainingSystemCode)</td>
                    <td>@Model.Major?.Name</td>
                    <td>sinh viên thứ @(int.Parse(ma.Substring(6, 4)))</td>
                </tr>
            </tbody>
        </table>
    </div>
}

<div class="mt-3">
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.StudentCode">Sửa</a>
    <a class="btn btn-secondary" asp-action="Index">Quay lại</a>
</div>
