@model DemoMVC.Models.Student
@{ var code = Model.StudentCode; var hasFullCode = code?.Length == 10; }
<dl class="row"><dt class="col-sm-4">Mã sinh viên</dt><dd class="col-sm-8"><code>@Model.StudentCode</code></dd><dt class="col-sm-4">Họ tên</dt><dd class="col-sm-8">@Model.FullName</dd><dt class="col-sm-4">Ngày sinh</dt><dd class="col-sm-8">@Html.DisplayFor(m => m.DateOfBirth)</dd><dt class="col-sm-4">Email</dt><dd class="col-sm-8">@(Model.Email ?? "—")</dd><dt class="col-sm-4">Khoa</dt><dd class="col-sm-8">@Model.Faculty?.Name</dd><dt class="col-sm-4">Ngành</dt><dd class="col-sm-8">@Model.Major?.Name</dd><dt class="col-sm-4">Năm nhập học</dt><dd class="col-sm-8">@Model.EnrollmentYear</dd><dt class="col-sm-4">Hệ đào tạo</dt><dd class="col-sm-8">@TrainingSystems.GetName(Model.TrainingSystemCode)</dd></dl>
@if (hasFullCode) { <h3 class="h6">Phân tích mã sinh viên</h3><p><code>@code.Substring(0, 2)</code> năm · <code>@code.Substring(2, 2)</code> hệ · <code>@code.Substring(4, 2)</code> ngành · <code>@code.Substring(6, 4)</code> số thứ tự</p> }
