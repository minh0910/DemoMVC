@model DemoMVC.Models.Student
@{
    Layout = "_ModalDetails";
    ViewData["Title"] = Model.FullName;
}
<dl class="row mb-0">
    <dt class="col-sm-4">Mã sinh viên</dt>
    <dd class="col-sm-8"><code>@Model.StudentCode</code></dd>
    <dt class="col-sm-4">Họ tên</dt>
    <dd class="col-sm-8">@Model.FullName</dd>
    <dt class="col-sm-4">Ngày sinh</dt>
    <dd class="col-sm-8">@Model.DateOfBirth?.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-4">Email</dt>
    <dd class="col-sm-8">@Model.Email</dd>
    <dt class="col-sm-4">Năm nhập học</dt>
    <dd class="col-sm-8">@Model.EnrollmentYear</dd>
    <dt class="col-sm-4">Hệ đào tạo</dt>
    <dd class="col-sm-8">@Model.TrainingSystemCode - @TrainingSystems.GetName(Model.TrainingSystemCode)</dd>
    <dt class="col-sm-4">Khoa</dt>
    <dd class="col-sm-8">@Model.Faculty?.Name</dd>
    <dt class="col-sm-4">Ngành</dt>
    <dd class="col-sm-8 mb-0">@Model.MajorCode - @Model.Major?.Name</dd>
</dl>
@section Footer {
    <button class="btn btn-warning" data-modal="@Url.Action("Form", new { id = Model.StudentCode })">Sửa</button>
}
