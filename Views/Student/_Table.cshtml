@model DemoMVC.Helpers.PaginatedList<DemoMVC.Models.Student>
@if (!Model.Any())
{
    <div class="alert alert-secondary">@(string.IsNullOrEmpty(Model.Keyword) ? "Không có sinh viên nào." : $"Không tìm thấy kết quả nào cho \"{Model.Keyword}\".")</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Mã sinh viên</th>
                    <th>Họ tên</th>
                    <th>Ngày sinh</th>
                    <th>Năm NH</th>
                    <th>Hệ đào tạo</th>
                    <th>Khoa</th>
                    <th>Ngành</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><code>@item.StudentCode</code></td>
                        <td>@item.FullName</td>
                        <td>@item.DateOfBirth?.ToString("dd/MM/yyyy")</td>
                        <td>@item.EnrollmentYear</td>
                        <td>@TrainingSystems.GetName(item.TrainingSystemCode)</td>
                        <td>@item.Faculty?.Name</td>
                        <td>@item.Major?.Name</td>
                        <td class="text-nowrap">
                            <button class="btn btn-sm btn-outline-info" data-modal="@Url.Action("Details", new { id = item.StudentCode })">Chi tiết</button>
                            <button class="btn btn-sm btn-outline-warning" data-modal="@Url.Action("Form", new { id = item.StudentCode })">Sửa</button>
                            <button class="btn btn-sm btn-outline-danger" data-delete="@Url.Action("Delete", new { id = item.StudentCode })" data-name="sinh viên @item.StudentCode - @item.FullName">Xoá</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
<partial name="_Pager" model="Model" />
