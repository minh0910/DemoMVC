@model IEnumerable<DemoMVC.Models.Student>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<h1>Danh sách sinh viên</h1>

<div class="alert alert-info">
    Mã sinh viên được <strong>sinh tự động</strong> khi thêm mới, ví dụ <code>2821050199</code>:
    <code>28</code> năm nhập học (2028) · <code>21</code> hệ đào tạo (đại học chính quy) ·
    <code>05</code> ngành (Công nghệ thông tin) · <code>0199</code> số thứ tự.
    Sinh viên tiếp theo cùng năm, hệ, ngành sẽ có mã <code>2821050200</code>.
</div>

<partial name="_ThongBao" />

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label class="form-label" for="facultyCode">Khoa</label>
        <select class="form-select" id="facultyCode" name="facultyCode" asp-items="ViewBag.FacultyList">
            <option value="">-- Tất cả khoa --</option>
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label" for="keyword">Tìm theo tên hoặc mã</label>
        <input class="form-control" id="keyword" name="keyword" value="@ViewBag.Keyword" />
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-outline-primary">Lọc</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Bỏ lọc</a>
        <a class="btn btn-primary" asp-action="Create">Thêm sinh viên</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>@Html.DisplayNameFor(m => m.StudentCode)</th>
                <th>@Html.DisplayNameFor(m => m.FullName)</th>
                <th>@Html.DisplayNameFor(m => m.DateOfBirth)</th>
                <th>@Html.DisplayNameFor(m => m.FacultyCode)</th>
                <th>@Html.DisplayNameFor(m => m.MajorCode)</th>
                <th>@Html.DisplayNameFor(m => m.EnrollmentYear)</th>
                <th>@Html.DisplayNameFor(m => m.TrainingSystemCode)</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="8" class="text-center text-muted">Không có sinh viên nào.</td></tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td><code>@item.StudentCode</code></td>
                    <td>@item.FullName</td>
                    <td>@Html.DisplayFor(m => item.DateOfBirth)</td>
                    <td>@item.Faculty?.Name</td>
                    <td>@item.Major?.Name</td>
                    <td>@item.EnrollmentYear</td>
                    <td>@TrainingSystems.GetName(item.TrainingSystemCode)</td>
                    <td class="text-nowrap">
                        <a asp-action="Details" asp-route-id="@item.StudentCode">Xem</a> |
                        <a asp-action="Edit" asp-route-id="@item.StudentCode">Sửa</a> |
                        <a asp-action="Delete" asp-route-id="@item.StudentCode">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<p>
    <a asp-controller="Faculty" asp-action="Index">Quản lý khoa</a> ·
    <a asp-controller="Major" asp-action="Index">Quản lý ngành</a>
</p>
