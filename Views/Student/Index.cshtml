@model IEnumerable<DemoMVC.Models.Student>

@{ ViewData["Title"] = "Danh sách sinh viên"; }

<h1>Danh sách sinh viên</h1>
<div class="alert alert-info">Mã sinh viên được sinh tự động khi thêm mới.</div>
<partial name="_ThongBao" />

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-4"><label class="form-label" for="facultyCode">Khoa</label><select class="form-select" id="facultyCode" name="facultyCode" asp-items="ViewBag.FacultyList"><option value="">-- Tất cả khoa --</option></select></div>
    <div class="col-md-4"><label class="form-label" for="keyword">Tìm theo tên hoặc mã</label><input class="form-control" id="keyword" name="keyword" value="@ViewBag.Keyword" /></div>
    <div class="col-md-4"><button type="submit" class="btn btn-outline-primary">Lọc</button><a class="btn btn-outline-secondary" asp-action="Index">Bỏ lọc</a><button type="button" class="btn btn-primary" data-ajax-modal="@Url.Action("Create")">Thêm sinh viên</button></div>
</form>

<div class="table-responsive">
<table class="table table-striped table-hover align-middle">
    <thead class="table-light"><tr><th>Mã SV</th><th>Họ tên</th><th>Ngày sinh</th><th>Khoa</th><th>Ngành</th><th>Năm nhập học</th><th>Thao tác</th></tr></thead>
    <tbody>
    @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted">Không có sinh viên nào.</td></tr> }
    @foreach (var item in Model)
    {
        <tr>
            <td><code>@item.StudentCode</code></td><td>@item.FullName</td><td>@Html.DisplayFor(m => item.DateOfBirth)</td><td>@item.Faculty?.Name</td><td>@item.Major?.Name</td><td>@item.EnrollmentYear</td>
            <td class="text-nowrap">
                <button type="button" class="btn btn-sm btn-outline-info" data-ajax-modal="@Url.Action("Details", new { id = item.StudentCode })">Xem</button>
                <button type="button" class="btn btn-sm btn-outline-primary" data-ajax-modal="@Url.Action("Edit", new { id = item.StudentCode })">Sửa</button>
                <button type="button" class="btn btn-sm btn-outline-danger" data-ajax-modal="@Url.Action("Delete", new { id = item.StudentCode })">Xóa</button>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
