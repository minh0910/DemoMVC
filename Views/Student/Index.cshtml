@{
    ViewData["Title"] = "Danh sách sinh viên";
    ViewData["Entity"] = "sinh viên";
    ViewData["Hint"] = "Mã sinh viên được <strong>sinh tự động</strong> khi thêm mới, ví dụ <code>2821050199</code>: "
        + "<code>28</code> năm nhập học (2028) · <code>21</code> hệ đào tạo · <code>05</code> ngành · <code>0199</code> số thứ tự. "
        + "Sinh viên tiếp theo cùng năm, hệ, ngành sẽ có mã <code>2821050200</code>.";
}

<partial name="_CrudPage" />

@* Lọc theo khoa và từ khoá: crud.js gửi kèm các ô của #filterForm khi tải bảng *@
<form id="filterForm" class="row g-2 align-items-end mb-3" autocomplete="off">
    <div class="col-md-4">
        <label class="form-label" for="facultyCode">Khoa</label>
        <select class="form-select" id="facultyCode" name="facultyCode" asp-items="ViewBag.FacultyList">
            <option value="">-- Tất cả khoa --</option>
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label" for="keyword">Tìm theo tên hoặc mã</label>
        <input class="form-control" id="keyword" name="keyword" />
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-outline-primary">Lọc</button>
    </div>
</form>

@section Scripts {
    <script>
        // Đưa ô lọc lên trên bảng
        $('#filterForm').insertBefore('#tableContainer');

        (function () {
            const nextCodeUrl = '@Url.Action("NextCode")';

            // Lọc dropdown Ngành theo Khoa đã chọn (danh sách ngành nằm trong data-majors của form)
            function fillMajors(selected) {
                const $major = $('#crudModal #MajorCode');
                const majors = $major.data('majors') || [];
                const faculty = $('#crudModal #FacultyCode').val();
                $major.empty().append(new Option(faculty ? '-- Chọn ngành --' : '-- Chọn khoa trước --', ''));
                majors.filter(m => m.facultyCode === faculty)
                    .forEach(m => $major.append(new Option(m.code + ' - ' + m.name, m.code, false, m.code === selected)));
            }

            // Xem trước mã sinh viên sẽ được cấp
            async function updatePreview() {
                const $preview = $('#crudModal #codePreview');
                if (!$preview.length) return;
                $preview.val('');
                const year = $('#crudModal #EnrollmentYear').val();
                const system = $('#crudModal #TrainingSystemCode').val();
                const major = $('#crudModal #MajorCode').val();
                if (!year || !system || !major) return;
                const params = new URLSearchParams({ enrollmentYear: year, trainingSystemCode: system, majorCode: major });
                const response = await fetch(nextCodeUrl + '?' + params);
                if (response.ok) {
                    const data = await response.json();
                    $preview.val(data.code ?? 'Không sinh được mã với thông tin đã chọn');
                }
            }

            $('#crudModal').on('form-loaded', function () {
                const $major = $('#crudModal #MajorCode');
                if ($major.is('select')) {
                    fillMajors($major.data('selected'));
                }
                updatePreview();
            });
            $(document).on('change', '#crudModal #FacultyCode', () => { fillMajors(''); updatePreview(); });
            $(document).on('change', '#crudModal #MajorCode, #crudModal #TrainingSystemCode', updatePreview);
            $(document).on('input', '#crudModal #EnrollmentYear', updatePreview);
        })();
    </script>
}
