@model DemoMVC.Models.Student

@{
    ViewData["Title"] = "Thêm sinh viên";
}

<h1>Thêm sinh viên</h1>

<hr />

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row">
        <div class="col-md-6">
            <h2 class="h5">Thông tin cá nhân</h2>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DateOfBirth" class="form-label"></label>
                <input asp-for="DateOfBirth" class="form-control" />
                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>

        <div class="col-md-6">
            <h2 class="h5">Thông tin đào tạo (dùng để sinh mã)</h2>

            <div class="mb-3">
                <label asp-for="EnrollmentYear" class="form-label"></label>
                <input asp-for="EnrollmentYear" class="form-control" min="2000" max="2099" />
                <span asp-validation-for="EnrollmentYear" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TrainingSystemCode" class="form-label"></label>
                <select asp-for="TrainingSystemCode" asp-items="ViewBag.TrainingSystemList" class="form-select">
                    <option value="">-- Chọn hệ đào tạo --</option>
                </select>
                <span asp-validation-for="TrainingSystemCode" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FacultyCode" class="form-label"></label>
                <select asp-for="FacultyCode" asp-items="ViewBag.FacultyList" class="form-select">
                    <option value="">-- Chọn khoa --</option>
                </select>
                <span asp-validation-for="FacultyCode" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MajorCode" class="form-label"></label>
                <select asp-for="MajorCode" class="form-select" data-selected="@Model.MajorCode">
                    <option value="">-- Chọn khoa trước --</option>
                </select>
                <span asp-validation-for="MajorCode" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" for="codePreview">Mã sinh viên (dự kiến)</label>
                <input id="codePreview" class="form-control fw-bold font-monospace" readonly placeholder="Chọn năm, hệ và ngành để xem mã" />
                <div class="form-text">
                    Mã chính thức được sinh ở server khi bấm Lưu:
                    2 số cuối năm nhập học + mã hệ + mã ngành + số thứ tự 4 chữ số.
                </div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            // Danh sách ngành kèm mã khoa, dùng để lọc dropdown Ngành theo Khoa đã chọn
            const majors = @Json.Serialize(ViewBag.Majors);
            const nextCodeUrl = '@Url.Action("NextCode")';

            const faculty = document.getElementById('FacultyCode');
            const major = document.getElementById('MajorCode');
            const year = document.getElementById('EnrollmentYear');
            const system = document.getElementById('TrainingSystemCode');
            const preview = document.getElementById('codePreview');

            function fillMajors(selected) {
                major.length = 0;
                const list = majors.filter(m => m.facultyCode === faculty.value);
                major.add(new Option(faculty.value ? '-- Chọn ngành --' : '-- Chọn khoa trước --', ''));
                list.forEach(m => major.add(new Option(m.code + ' - ' + m.name, m.code, false, m.code === selected)));
            }

            async function updatePreview() {
                preview.value = '';
                if (!year.value || !system.value || !major.value) {
                    return;
                }
                const params = new URLSearchParams({
                    enrollmentYear: year.value,
                    trainingSystemCode: system.value,
                    majorCode: major.value
                });
                const response = await fetch(nextCodeUrl + '?' + params);
                if (response.ok) {
                    const data = await response.json();
                    preview.value = data.code ?? 'Không sinh được mã với thông tin đã chọn';
                }
            }

            faculty.addEventListener('change', () => { fillMajors(''); updatePreview(); });
            [major, system].forEach(el => el.addEventListener('change', updatePreview));
            year.addEventListener('input', updatePreview);

            fillMajors(major.dataset.selected);
            updatePreview();
        })();
    </script>
}
