@* Bài 11-12: khung trang danh sách dùng chung (tiêu đề, nút Thêm, ô tìm kiếm, bảng tải bằng Ajax) *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@ViewData["Title"]</h1>
    <button class="btn btn-primary" data-modal="@Url.Action("Form")">+ Thêm @ViewData["Entity"]</button>
</div>
@if (ViewData["Hint"] is string hint)
{
    <p class="text-muted">@Html.Raw(hint)</p>
}

@* Bài 12: các ô trong #filterForm được gửi kèm khi tải bảng (keyword, pageSize và bộ lọc riêng của từng trang) *@
<form id="filterForm" class="row g-2 align-items-end mb-3" autocomplete="off">
    @if (ViewData["FilterPartial"] is string filterPartial)
    {
        <partial name="@filterPartial" />
    }
    <div class="col-md-4">
        <label class="form-label" for="keyword">Tìm kiếm</label>
        <input type="search" class="form-control" id="keyword" name="keyword"
               placeholder="@(ViewData["SearchHint"] ?? "Nhập từ khoá...")" />
    </div>
    <div class="col-auto">
        <label class="form-label" for="pageSize">Số dòng / trang</label>
        <select class="form-select" id="pageSize" name="pageSize">
            @foreach (var size in DemoMVC.Helpers.PaginatedList<object>.PageSizes)
            {
                <option value="@size" selected="@(size == DemoMVC.Helpers.PaginatedList<object>.DefaultPageSize)">@size</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Tìm</button>
    </div>
</form>

<div id="tableContainer" data-url="@Url.Action("List")">
    <div class="text-center text-muted py-5">Đang tải dữ liệu...</div>
</div>
